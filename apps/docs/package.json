  "dependencies": {
    "@astrojs/starlight": "^0.34.0",
    "ajv": "^8.18.0",
    "astro": "^5.7.0",
    "starlight-openapi": "^0.9.0"
  },
  "devDependencies": {
    "wrangler": "^4.14.0"
  }
}
