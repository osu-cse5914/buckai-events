generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// ─── User ───────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  clerkId        String   @unique
  email          String   @unique
  role           UserRole @default(USER)
  displayName    String?  @db.VarChar(100)
  major          String?  @db.VarChar(100)
  gradYear       Int?
  interests      String[]
  followerCount  Int      @default(0)
  followingCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events        Event[]
  applications  Application[]
  collections   Collection[]
  interactions  Interaction[]
  conversations Conversation[]
  followers     Follow[]       @relation("followee")
  following     Follow[]       @relation("follower")
  eventPipelineJobs EventPipelineJob[]
}

// ─── Event ──────────────────────────────────────────────────────────────────────

model Event {
  id                 String       @id @default(cuid())
  title              String       @db.VarChar(200)
  description        String       @db.VarChar(5000)
  summary            String?      @db.VarChar(500)
  type               EventType
  source             EventSource
  externalId         String?      @unique
  sourceHash         String?
  category           String?
  tags               String[]
  imageUrl           String?
  ticketUrl          String?
  externalUrl        String?
  locationName       String       @db.VarChar(500)
  locationLatitude   Float?
  locationLongitude  Float?
  startAt            DateTime
  endAt              DateTime?
  compensationAmount Float?
  compensationCurrency String?    @default("USD")
  compensationType   CompensationType?
  status             EventStatus  @default(OPEN)
  creatorId          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  creator         User?            @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  applications    Application[]
  collectionItems CollectionItem[]
  interactions    Interaction[]
  embedding       EventEmbedding?
  pipelineRuns    EventPipelineRun[]

  @@index([creatorId])
}

// ─── Application ────────────────────────────────────────────────────────────────

model Application {
  id          String    @id @default(cuid())
  gigId       String
  applicantId String
  message     String?   @db.VarChar(1000)
  status      AppStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gig       Event @relation(fields: [gigId], references: [id], onDelete: Cascade)
  applicant User  @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([gigId, applicantId])
  @@index([applicantId])
}

// ─── Follow ─────────────────────────────────────────────────────────────────────

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

// ─── Collection ─────────────────────────────────────────────────────────────────

model Collection {
  id         String               @id @default(cuid())
  userId     String
  name       String               @db.VarChar(100)
  visibility CollectionVisibility @default(PRIVATE)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  eventId      String
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([collectionId, eventId])
  @@index([eventId])
}

// ─── Interaction ────────────────────────────────────────────────────────────────

model Interaction {
  id        String          @id @default(cuid())
  userId    String
  eventId   String
  action    InteractionType
  createdAt DateTime        @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
}

// ─── Conversation & Message ─────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?  @db.VarChar(200)
  pendingAction Json?
  pendingActionCreatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.VarChar(10000)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─── EventEmbedding ─────────────────────────────────────────────────────────────

model EventEmbedding {
  id        String                       @id @default(cuid())
  eventId   String                       @unique
  embedding Unsupported("vector(768)")
  textHash  String
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventPipelineJob {
  id                String                 @id @default(cuid())
  trigger           EventPipelineTrigger
  status            EventPipelineJobStatus @default(QUEUED)
  stages            String[]
  error             String?
  requestedByUserId String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  startedAt         DateTime?
  finishedAt        DateTime?

  requestedBy User?               @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  runs        EventPipelineRun[]

  @@index([requestedByUserId])
}

model EventPipelineRun {
  id         String                 @id @default(cuid())
  jobId      String
  eventId    String
  stage      EventPipelineStage
  status     EventPipelineRunStatus @default(QUEUED)
  textHash   String?
  error      String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  job   EventPipelineJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  event Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([jobId, eventId, stage])
  @@index([jobId])
  @@index([eventId])
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum EventType {
  EVENT
  GIG
}

enum EventSource {
  OSU_API
  TICKETMASTER
  USER
}

enum EventStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InteractionType {
  VIEW
  SAVE
  CLICK
  APPLY
  DISMISS
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum CollectionVisibility {
  PRIVATE
  PUBLIC
}

enum CompensationType {
  FIXED
  HOURLY
}

enum EventPipelineTrigger {
  EVENT_CREATE
  EVENT_UPDATE
  ADMIN_RERUN
  EMBEDDING_BACKFILL
}

enum EventPipelineJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum EventPipelineRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  SKIPPED
  FAILED
}

enum EventPipelineStage {
  TAGGING
  EMBEDDING
}
