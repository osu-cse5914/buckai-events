DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_osu_app?schema=public"
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Clerk (https://dashboard.clerk.com → API Keys)
CLERK_SECRET_KEY=sk_test_...

# Google Gemini API key used by the router config below.
GOOGLE_GENERATIVE_AI_API_KEY=google_key_here

# Add any extra provider secrets referenced by AI_ROUTER_CONFIG_JSON.
# Example for an OPENAI_COMPATIBLE provider entry:
# OPENAI_PRIMARY_API_KEY=openai_compatible_key_here

# AI router configuration as a JSON string.
AI_ROUTER_CONFIG_JSON='{"providers":{"google":{"id":"google","type":"GOOGLE","apiKeyEnvVar":"GOOGLE_GENERATIVE_AI_API_KEY"}},"models":{"gemini-flash":{"id":"gemini-flash","providerId":"google","modelId":"gemini-2.5-flash","type":"GENERATIVE","maxTokens":1024},"gemini-pro":{"id":"gemini-pro","providerId":"google","modelId":"gemini-2.5-pro","type":"GENERATIVE","maxTokens":2048},"text-embed":{"id":"text-embed","providerId":"google","modelId":"gemini-embedding-001","type":"EMBEDDING","dimensions":768}},"tasks":{"chatbot":{"id":"chatbot","modelId":"gemini-pro","temperature":0.7},"tagging":{"id":"tagging","modelId":"gemini-flash","systemPrompt":"You classify campus events into structured metadata.","temperature":0.3,"maxOutputTokens":300},"title-generation":{"id":"title-generation","modelId":"gemini-flash","temperature":0.5,"maxOutputTokens":80},"embedding":{"id":"embedding","modelId":"text-embed"}}}'

# Optional: override the default shared development Clerk publishable key.
# CLERK_PUBLISHABLE_KEY=pk_test_...
