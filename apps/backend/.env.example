DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_osu_app?schema=public"
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Clerk (https://dashboard.clerk.com → API Keys)
CLERK_SECRET_KEY=sk_test_...

# Cloudflare API token used by the AI Gateway routes below.
# This token should include AI Gateway permissions and Workers AI read access.
CF_AIG_TOKEN=cf_aig_token_here

# Add any extra provider secrets referenced by AI_ROUTER_CONFIG_JSON.
# Example:
# SOME_PROVIDER_API_KEY=provider_key_here

# AI router configuration as a multiline JSON string.
# This config controls providers, models, task mapping, and task tuning.
# System prompts stay in application code.
AI_ROUTER_CONFIG_JSON='{
  "providers": {
    "openrouter": {
      "id": "openrouter",
      "type": "OPENAI_COMPATIBLE",
      "baseUrl": "https://gateway.ai.cloudflare.com/v1/2b7085f62464ab452fbd1c9569cedaef/esperta-gateway/openrouter/v1",
      "headersEnv": {
        "cf-aig-authorization": "CF_AIG_TOKEN"
      }
    },
    "cf-aig": {
      "id": "cf-aig",
      "type": "CF_AI_GATEWAY",
      "apiKeyEnvVar": "CF_AIG_TOKEN",
      "accountId": "2b7085f62464ab452fbd1c9569cedaef",
      "gateway": "esperta-gateway"
    }
  },
  "models": {
    "social-osu": {
      "id": "social-osu",
      "providerId": "cf-aig",
      "modelId": "custom-minimax/MiniMax-M2.7",
      "type": "GENERATIVE",
      "maxTokens": 2048,
      "contextWindow": 1000000
    },
    "social-osu-embedding": {
      "id": "social-osu-embedding",
      "providerId": "openrouter",
      "modelId": "nvidia/llama-nemotron-embed-vl-1b-v2:free",
      "type": "EMBEDDING",
      "dimensions": 768,
      "contextWindow": 131072
    }
  },
  "tasks": {
    "chatbot": {
      "id": "chatbot",
      "modelId": "social-osu",
      "temperature": 0.7
    },
    "tagging": {
      "id": "tagging",
      "modelId": "social-osu",
      "temperature": 0.3,
      "maxOutputTokens": 300
    },
    "title-generation": {
      "id": "title-generation",
      "modelId": "social-osu",
      "temperature": 0.5,
      "maxOutputTokens": 80
    },
    "embedding": {
      "id": "embedding",
      "modelId": "social-osu-embedding"
    }
  }
}'

# Optional: override the default shared development Clerk publishable key.
# CLERK_PUBLISHABLE_KEY=pk_test_...
