{
  "name": "social-osu-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=!@social-osu/docs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test:registry:audit": "bun scripts/audit-test-registry.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "test:regression:phase-0": "turbo run test -- --reporter=verbose -t '\\[phase:0\\]'",
    "test:regression:phase-1": "turbo run test -- --reporter=verbose -t '\\[phase:[01]\\]'",
    "test:regression:phase-2": "turbo run test -- --reporter=verbose -t '\\[phase:[0-2]\\]'",
    "test:regression:phase-3": "turbo run test -- --reporter=verbose -t '\\[phase:[0-3]\\]'",
    "test:regression:phase-4": "turbo run test -- --reporter=verbose -t '\\[phase:[0-4]\\]'",
    "test:regression:phase-5": "turbo run test -- --reporter=verbose -t '\\[phase:[0-5]\\]'",
    "test:regression:phase-6": "turbo run test -- --reporter=verbose",
    "test:manual-checklist": "bun scripts/generate-regression-issue.ts",
    "db:generate": "bun --cwd apps/backend prisma generate",
    "db:migrate": "bun --cwd apps/backend prisma migrate dev",
    "db:push": "bun --cwd apps/backend prisma db push",
    "deploy": "turbo run deploy",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "turbo": "^2.8.10"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.22"
}
